@page "/Error"
@using System.Diagnostics

<PageTitle>Fout</PageTitle>

<h1 class="text-danger">Fout.</h1>
<h2 class="text-danger">Er is een fout opgetreden bij het verwerken van uw aanvraag.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>Aanvraag ID:</strong> <code>@requestId</code>
    </p>
}

<h3>Ontwikkelingsmodus</h3>
<p>
    Overschakelen naar de <strong>Ontwikkelingsomgeving</strong> toont meer gedetailleerde informatie over de opgetreden fout.
</p>
<p>
    <strong>De Ontwikkelingsomgeving mag niet worden ingeschakeld voor geïmplementeerde toepassingen.</strong>
    Dit kan leiden tot het tonen van gevoelige informatie uit uitzonderingen aan eindgebruikers.
    Schakel voor lokale debugging de <strong>Ontwikkelingsomgeving</strong> in door de <strong>ASPNETCORE_ENVIRONMENT</strong> omgevingsvariabele op <strong>Development</strong> in te stellen
    en de app opnieuw op te starten.
</p>

@code{
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private string? requestId;
    private bool ShowRequestId => !string.IsNullOrEmpty(requestId);

    protected override void OnInitialized()
    {
        requestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
